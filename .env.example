# Copie para .env.local (nunca versionar). Variáveis NEXT_PUBLIC_ vão para o navegador; o resto é só servidor.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# AES-256-GCM: lista "id:chaveBase64de32bytes" separada por vírgula; a atual cifra, as demais só decifram
CRIPTO_CHAVES=
CRIPTO_CHAVE_ATUAL=
# HMAC para deduplicação e hash de IP
HASH_PIMENTA=
MANUAL_STORAGE_CAMINHO=
WEBHOOK_AUTOMACAO_URL=
WEBHOOK_AUTOMACAO_SEGREDO=
META_CAPI_TOKEN=
# Papo reto (ADR 0003). Sem ANTHROPIC_API_KEY a conversa usa o roteiro local (só fora de produção).
NEXT_PUBLIC_PAPO_RETO=
ANTHROPIC_API_KEY=
AI_MODEL_DIALOGO=claude-sonnet-5-5
# HMAC do estado da conversa que o navegador reenvia
PAPO_RETO_SEGREDO=
